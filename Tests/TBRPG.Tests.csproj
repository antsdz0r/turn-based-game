<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the pure C# game rules (Scripts/Core). Run from the repo root:  dotnet test Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TBRPG.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core has no Godot dependency, so it compiles straight into the test assembly. -->
    <Compile Include="../Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
